# ============================================================
# NgawiMusical Backend — contoh konfigurasi lokal
# Salin menjadi .env lalu sesuaikan. Jangan commit nilai rahasia.
# ============================================================

# Aplikasi
APP_ENV=development
APP_NAME=ngawimusical-backend
APP_PORT=8080
API_PORT=8080
APP_BASE_URL=http://127.0.0.1:8080
APP_REQUEST_TIMEOUT=3s
APP_TRUSTED_PROXIES=
APP_CORS_ALLOWED_ORIGINS=
LOG_LEVEL=debug

# PostgreSQL — sumber kebenaran
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ngawimusical
DB_PASSWORD=ngawimusical
DB_NAME=ngawimusical
DB_SSLMODE=disable
DB_MAX_CONNS=60
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=1s
DB_LOCK_TIMEOUT=250ms
DB_TX_DEADLINE=3s
DB_RETRY_MAX=2

# Redis admission (antrean, pass, limiter)
REDIS_ADMISSION_ADDR=127.0.0.1:6379
REDIS_ADMISSION_PASSWORD=
REDIS_ADMISSION_DB=0

# Redis queue (Asynq) — instance terpisah
REDIS_QUEUE_ADDR=127.0.0.1:6380
REDIS_QUEUE_PASSWORD=
REDIS_QUEUE_DB=0
ASYNQ_CONCURRENCY=10

# MongoDB — modul ulasan
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=ngawimusical
MONGO_CONNECT_TIMEOUT=5s

# Autentikasi
JWT_ISSUER=ngawimusical
JWT_AUDIENCE=ngawimusical-api
JWT_ACCESS_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=168h
ADMISSION_PASS_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
ADMISSION_PASS_TTL=60s
TICKET_TOKEN_ENC_KEY=ganti-dengan-base64-32-byte-key
BCRYPT_COST=12
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Aturan bisnis dan kapasitas
HOLD_TTL=10m
RELEASE_GRACE=120s
MAX_TICKETS_PER_USER=4
MAX_SWAP_PER_HOLD=2
ADMISSION_PASSES_PER_SECOND=50
RESERVE_RATE_PER_USER=2
RESERVE_BURST_PER_USER=2
QUEUE_ENTRY_IDLE_TIMEOUT=5m
QUEUE_HEARTBEAT_INTERVAL=30s

# Provider pembayaran dan notifikasi (simulator)
PAYMENT_PROVIDER=simulator
PAYMENT_SIMULATOR_BASE_URL=http://127.0.0.1:9091
PAYMENT_SIMULATOR_SECRET=simulator-secret
NOTIFICATION_PROVIDER=simulator
NOTIFICATION_SIMULATOR_BASE_URL=http://127.0.0.1:9092
NOTIFICATION_SIMULATOR_SECRET=simulator-secret

# Worker dan scheduler
OUTBOX_RELAY_INTERVAL=1s
OUTBOX_LEASE=30s
EXPIRY_SCAN_INTERVAL=5s
PAYMENT_RECONCILE_INTERVAL=15s

# Observability
METRICS_ENABLED=true
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=
